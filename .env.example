# ============================================
# Database Configuration (Supabase / Postgres)
# ============================================
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres

# Optional direct SQL connection fallback
SQL_HOST=localhost
SQL_USER=aqs
SQL_PASSWORD=[PASSWORD]
SQL_DB_NAME=aqs_learning
SQL_ADMIN_USER=aqs_admin
SQL_ADMIN_PASSWORD=[ADMIN_PASSWORD]
SQL_SSL=true

# ============================================
# Firebase Authentication & Admin SDK
# ============================================
FIREBASE_PROJECT_ID=aqs-learning-local
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ============================================
# Application & Storage Configuration
# ============================================
APP_URL=http://localhost:3000
STORAGE_PROVIDER=database
# R2_BUCKET=aqs-learning
# R2_ACCOUNT_ID=[ACCOUNT_ID]
# R2_ACCESS_KEY_ID=[ACCESS_KEY_ID]
# R2_SECRET_ACCESS_KEY=[SECRET_ACCESS_KEY]