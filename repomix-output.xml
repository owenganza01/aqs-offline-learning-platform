      }, (res) => {
        let buf = '';
        res.on('data', (c) => buf += c);
        res.on('end', () => { try { resolve(JSON.parse(buf)); } catch { resolve(buf); } });
      });
      req.on('error', reject);
      req.write(body);
      req.end();
    });
    if (token.error) {
      console.log(`Sign-in error for ${u.email}:`, token.error.message);
