	"item": [
		{
			"name": "Authentication & Profile",
			"item": [
				{
					"name": "Get Profile details (Me)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/auth/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"me"
							]
						},
						"description": "Acquires the currently logged-in user profile from the database, corresponding to the verified Firebase Auth ID Token. Automatically registers the user if it is their first time logging in."
					},
					"response": []
				},
				{
					"name": "Update User Role (Switch)",
					"request": {
						"method": "PUT",
