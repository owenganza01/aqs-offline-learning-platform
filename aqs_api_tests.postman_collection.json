							"raw": "{\n    \"lessonCompletions\": [\n        {\n            \"lessonId\": 1,\n            \"completedAt\": \"2026-06-24T09:12:00.000Z\"\n        }\n    ],\n    \"quizSubmissions\": [\n        {\n            \"quizId\": 1,\n            \"answers\": [0, 2, 1],\n            \"attemptedAt\": \"2026-06-24T09:15:30.000Z\"\n        }\n    ]\n}"
